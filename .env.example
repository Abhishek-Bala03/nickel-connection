# Copy to .env (git-ignored). Read by docker compose, and by app/conf/application.conf through the
# environment. Secrets never go in this file or the repository.

# development | qa | production
NICKEL_ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
NICKEL_LOG_LEVEL=INFO

# Browser origins allowed to call the API, comma-separated (e.g. the connections UI). Empty: none.
NICKEL_CORS_ORIGINS=http://localhost:3000

# Host port for docker compose.
NICKEL_PORT=8000
