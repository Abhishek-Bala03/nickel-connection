# Copy to .env (git-ignored). Read by docker compose, and by app/conf/application.conf through the
# environment. Secrets never go in this file or the repository.

# development | qa | production. Unset, the service runs as production: /docs, /redoc and
# /openapi.json are off. They are on in development only (they need no token, so a deployment on a
# network keeps them off); set development here for the API docs on a laptop.
NICKEL_ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
NICKEL_LOG_LEVEL=INFO

# Browser origins allowed to call the API, comma-separated (e.g. the connections UI). Empty: none.
NICKEL_CORS_ORIGINS=http://localhost:3000

# The service token: every route but /health and /ready needs `Authorization: Bearer <token>`. The
# scheduler and the Nickel API layer get the same value from Vault; the service does not start without
# one, and refuses one shorter than 32 characters. Generate one for local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In K3s, mount the secret as a file and set NICKEL_SERVICE_TOKEN_FILE=/run/secrets/nickel-service-token
# instead (one of the two, never both).
NICKEL_SERVICE_TOKEN=

# Host port for docker compose.
NICKEL_PORT=8000

# The tenant this deployment ingests for: a UUID, never a clinic name or a sequence number.
# Provisional: until the platform decides how background jobs get their tenant from the identity
# provider, connectors read it here. Single-tenant deployments set one value.
NICKEL_TENANT_ID=0192a3b4-0000-7000-8000-000000000001

# Outside Docker only (the image uses /data): where the File Store, the raw_data outbox, the receipts
# and the job records go (app/src/db/layout.py).
NICKEL_DATA_DIR=.data

# Largest single payload accepted, in bytes (100 MB).
NICKEL_MAX_FILE_BYTES=104857600

# How many jobs may wait in the queue; a POST /jobs/* beyond it is a 429 with Retry-After.
NICKEL_JOBS_MAX_QUEUED=100

# Source credentials do not go in this file: export KAGGLE_API_TOKEN or HF_TOKEN in your shell when a
# manifest needs them (docs/docker.md).
