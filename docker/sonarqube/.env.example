# Copy to docker/sonarqube/.env and set your own value. .env files are git-ignored; never commit one.
SONAR_DB_PASSWORD=change-me

# Where SonarQube listens: 127.0.0.1 = this machine only (default); 0.0.0.0 = the whole network,
# e.g. teammates on the tailnet when it runs on a dev server.
SONAR_BIND=127.0.0.1
